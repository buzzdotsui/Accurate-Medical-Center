# Mobile App Environment Configuration
# Copy this file to .env and update values as needed

# API Base URL - Development (Android emulator uses 10.0.2.2 for host machine)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# API Base URL - Production
# EXPO_PUBLIC_API_URL=https://accuratemedicalcentre.com

# App Configuration
EXPO_PUBLIC_APP_NAME=Accurate Medical Center
EXPO_PUBLIC_APP_SLUG=accurate-medical-center