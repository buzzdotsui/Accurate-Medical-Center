# Accurate Medical Center HMS — Environment Variables
# Copy this file to .env.local for local development, or set these in your hosting platform.
# Run `npm run verify:env` to validate required secrets before deploying.

# =============================================================================
# REQUIRED — app will not start correctly without these
# =============================================================================

# PostgreSQL — pooled connection used by the app at runtime (via PrismaPg adapter)
DATABASE_URL=postgresql://user:password@host:5432/accurate_medical?schema=public

# PostgreSQL — direct (non-pooled) connection used by Prisma CLI (db push, migrate, etc.)
DIRECT_URL=postgresql://user:password@host:5432/accurate_medical?schema=public

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string

# Production URL of the app (no trailing slash)
# Used by Better Auth for CSRF, cookie domain, password-reset links, and emails
BETTER_AUTH_URL=https://accuratemedicalcentre.com
NEXT_PUBLIC_APP_URL=https://accuratemedicalcentre.com

# Rate limiting (Upstash Redis REST — must be HTTPS, not a tcp redis:// URL)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# =============================================================================
# RECOMMENDED — features degrade gracefully without these, but set them in prod
# =============================================================================

# Cloudinary — media CDN for images and videos
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend — transactional email (appointment confirmations, contact form, password reset)
# Create an account at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@accuratemedicalcentre.com
CONTACT_EMAIL_TO=info@accuratemedicalcentre.com

# Sentry — error tracking and performance monitoring
# Create a project at https://sentry.io
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Supabase — used for Realtime subscriptions on the client
# Find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# OPTIONAL
# =============================================================================

# Sentry source-map upload (CI/CD only — leave blank for local builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=accurate-medical-center

# Phase 1 deferred modules gate (keep false/unset in production)
# Set to "true" only to preview unfinished specialty modules (psych, ambulance, theatre, maternal)
# PHASE1_ENABLE_DEFERRED_MODULES=false
