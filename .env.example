# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Transaction Pooler connection (port 6543) — used by the application at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct PostgreSQL connection (port 5432) — used by Prisma Migrate only
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="https://your-domain.com"

# ─── Public App URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="Accurate Medical Center"

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://YOUR-UPSTASH-ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# ─── Email (Resend — optional) ────────────────────────────────────────────────
# Use a Resend-verified sender/domain. Never use the visitor's address here.
RESEND_API_KEY=""
EMAIL_FROM="Accurate Medical Center <verified-sender@example.com>"
# Server-only destination for website contact-form notifications.
CONTACT_EMAIL_TO="accuratemedicalcenter@yahoo.com"

# ─── Monitoring (Sentry — optional) ──────────────────────────────────────────
# SENTRY_DSN=""
